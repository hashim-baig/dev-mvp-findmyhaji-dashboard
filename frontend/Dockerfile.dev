# Development React Frontend Dockerfile
FROM node:20-alpine

# Set working directory
WORKDIR /app/frontend

# Install system dependencies
RUN apk add --no-cache \
    bash \
    git \
    && rm -rf /var/cache/apk/*

# Copy package files
COPY package.json ./
COPY yarn.lock ./

# Install dependencies
RUN yarn install --frozen-lockfile

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["yarn", "start"]